generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
  DRIVER
  VENDOR
}
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}
enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}
enum TripStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
enum LoadStatus {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  DELIVERED
}
enum RequestKind {
  TOPUP
  WITHDRAWAL
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
enum OtpPurpose {
  VERIFY
  RESET
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DELIVERED
  CANCELLED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}
enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}
enum TxType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  EARNING
  REFUND
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  phone String?
  passwordHash String
  role Role
  status UserStatus @default(PENDING)
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  vehicles Vehicle[]
  trips Trip[] @relation("DriverTrips")
  bookings Booking[]
  postedLoads Load[] @relation("PostedLoads")
  acceptedLoads Load[] @relation("DriverLoads")
  wallet Wallet?
  paymentRequests PaymentRequest[]
  notifications Notification[]
  products Product[] @relation("VendorProducts")
  vendorOrders VendorOrder[] @relation("VendorOrders")
  customerOrders VendorOrder[] @relation("CustomerOrders")
  sentMessages Message[] @relation("Sent")
  receivedMessages Message[] @relation("Received")
  reviewsWritten Review[] @relation("ReviewsWritten")
  reviewsReceived Review[] @relation("ReviewsReceived")
  tickets Ticket[]
  ticketReplies TicketReply[] @relation("TicketAuthor")
  tokenVersion Int @default(0) // bump to sign out every existing session
  documents Document[]
  emailVerified Boolean @default(true) // existing/seeded users stay verified; self-registration sets false
}
model Vehicle {
  id String @id @default(cuid())
  plate String @unique
  type String
  capacity String?
  status VehicleStatus @default(ACTIVE)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  trips Trip[]
}
model Trip {
  id String @id @default(cuid())
  origin String
  destination String
  departAt DateTime
  price Int
  seats Int @default(1)
  seatsLeft Int @default(1)
  status TripStatus @default(UPCOMING)
  driverId String
  driver User @relation("DriverTrips", fields: [driverId], references: [id])
  vehicleId String?
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  bookings Booking[]
}
model Booking {
  id String @id @default(cuid())
  status BookingStatus @default(PENDING)
  amount Int
  seats Int @default(1)
  createdAt DateTime @default(now())
  customerId String
  customer User @relation(fields: [customerId], references: [id])
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
}
model Load {
  id String @id @default(cuid())
  item String
  origin String
  destination String
  weightKg Int
  status LoadStatus @default(AVAILABLE)
  price Int @default(0)
  postedById String
  postedBy User @relation("PostedLoads", fields: [postedById], references: [id])
  driverId String?
  driver User? @relation("DriverLoads", fields: [driverId], references: [id])
  createdAt DateTime @default(now())
}
model Wallet {
  id String @id @default(cuid())
  balance Decimal @default(0) @db.Decimal(12,2)
  currency String @default("ETB")
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  transactions Transaction[]
}
model Transaction {
  id String @id @default(cuid())
  type TxType
  amount Decimal @db.Decimal(12,2)
  note String?
  createdAt DateTime @default(now())
  walletId String
  wallet Wallet @relation(fields: [walletId], references: [id])
}

model PaymentRequest {
  id String @id @default(cuid())
  kind RequestKind
  amount Int
  method String
  reference String
  status RequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id])
}
model Commission {
  id String @id @default(cuid())
  loadId String? @unique
  orderId String? @unique
  tripId String? @unique
  amount Int
  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())
  title String
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id])
  @@index([userId, read])
}

model OtpCode {
  id String @id @default(cuid())
  email String
  purpose OtpPurpose
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([email, purpose])
}

model Product {
  id String @id @default(cuid())
  name String
  category String
  description String?
  unit String @default("unit")
  price Int
  stock Int
  expiresAt DateTime?
  createdAt DateTime @default(now())
  vendorId String
  vendor User @relation("VendorProducts", fields: [vendorId], references: [id])
  orders VendorOrder[]
}
model VendorOrder {
  id String @id @default(cuid())
  quantity Int
  total Int
  status OrderStatus @default(PENDING)
  createdAt DateTime @default(now())
  productId String
  product Product @relation(fields: [productId], references: [id])
  vendorId String
  vendor User @relation("VendorOrders", fields: [vendorId], references: [id])
  customerId String
  customer User @relation("CustomerOrders", fields: [customerId], references: [id])
}

model Message {
  id String @id @default(cuid())
  body String
  read Boolean @default(false)
  createdAt DateTime @default(now())
  senderId String
  sender User @relation("Sent", fields: [senderId], references: [id])
  recipientId String
  recipient User @relation("Received", fields: [recipientId], references: [id])
  @@index([recipientId, read])
  @@index([senderId, recipientId])
}
model Review {
  id String @id @default(cuid())
  rating Int
  comment String?
  createdAt DateTime @default(now())
  authorId String
  author User @relation("ReviewsWritten", fields: [authorId], references: [id])
  targetId String
  target User @relation("ReviewsReceived", fields: [targetId], references: [id])
  loadId String?
  orderId String?
  @@unique([authorId, loadId])
  @@unique([authorId, orderId])
}

model Ticket {
  id String @id @default(cuid())
  subject String
  category String
  priority TicketPriority @default(MEDIUM)
  status TicketStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId String
  user User @relation(fields: [userId], references: [id])
  replies TicketReply[]
}
model TicketReply {
  id String @id @default(cuid())
  body String
  createdAt DateTime @default(now())
  ticketId String
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author User @relation("TicketAuthor", fields: [authorId], references: [id])
}

model RateLimit {
  key String @id
  count Int
  resetAt DateTime
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  target String?
  meta String?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model Document {
  id String @id @default(cuid())
  kind String
  filename String
  mime String
  size Int
  data Bytes
  status DocStatus @default(PENDING)
  note String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  userId String
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
}

model DriverLocation {
  userId String @id
  lat Float
  lng Float
  updatedAt DateTime @updatedAt
}
